import streamlit as st
import pandas as pd
import plotly.express as px

# -------------------------------
# 1. 基本设置
# -------------------------------
st.set_page_config(
    page_title="축구 선수 경력 통계 분석",
    page_icon="⚽",
    layout="wide"
)

# -------------------------------
# 2. 标题
# -------------------------------
st.title("⚽ 축구 선수의 직업 경력 통계 분석")
st.write("프로 축구 선수들의 출장 수, 골 수, 도움 수 등을 시각화하여 한눈에 분석할 수 있는 대시보드입니다.")

# -------------------------------
# 3. 示例 데이터 생성
# -------------------------------
players = {
    "선수명": ["호날두", "메시", "김민재", "박지성", "레반도프스키", "모하메드 살라"],
    "국가": ["포르투갈", "아르헨티나", "한국", "한국", "폴란드", "이집트"],
    "나이": [38, 36, 27, 42, 35, 31],
    "리그": ["사우디 프로 리그", "인터 Miami", "바르셀로나", "은퇴", "바이에른 뮌헨", "리버풀"],
    "출장 수": [1200, 1150, 450, 500, 950, 600],
    "골 수": [850, 820, 35, 50, 700, 300],
    "도움 수": [230, 350, 40, 100, 150, 150],
    "평점(10점 만점)": [8.6, 8.9, 8.3, 7.8, 8.5, 8.4]
}

df = pd.DataFrame(players)

# -------------------------------
# 4. 사이드바 추가
# -------------------------------
st.sidebar.header("⚙️ 필터 설정")

# 국가 선택
country_filter = st.sidebar.multiselect(
    "국가 선택:",
    options=df["국가"].unique(),
    default=df["국가"].unique()
)

# 리그 선택
league_filter = st.sidebar.multiselect(
    "리그 선택:",
    options=df["리그"].unique(),
    default=df["리그"].unique()
)

# 선수 검색
search_name = st.sidebar.text_input("선수 검색 (예: 메시)")

# 정렬 옵션
sort_option = st.sidebar.selectbox(
    "정렬 기준:",
    ["골 수", "출장 수", "평점(10점 만점)", "도움 수"]
)

# 데이터 보이기 여부
show_table = st.sidebar.checkbox("선수 데이터 표시", value=True)

# 그래프 선택
graph_type = st.sidebar.radio(
    "그래프 종류 선택:",
    ["골 수 비교", "출장 수 비교", "도움 수 비교", "국가 분포"]
)

# -------------------------------
# 5. 필터 적용
# -------------------------------
filtered_df = df[df["국가"].isin(country_filter) & df["리그"].isin(league_filter)]

if search_name:
    filtered_df = filtered_df[filtered_df["선수명"].str.contains(search_name)]

filtered_df = filtered_df.sort_values(by=sort_option, ascending=False)

# -------------------------------
# 6. 데이터 테이블 표시
# -------------------------------
if show_table:
    st.subheader("📋 선수 기본 데이터")
    st.dataframe(filtered_df, use_container_width=True)

# -------------------------------
# 7. 선택된 그래프 출력
# -------------------------------
if graph_type == "골 수 비교":
    st.subheader("⚽ 선수별 골 수 비교")
    fig = px.bar(filtered_df, x="선수명", y="골 수", color="국가", text="골 수")
    st.plotly_chart(fig, use_container_width=True)

elif graph_type == "출장 수 비교":
    st.subheader("📊 선수별 출장 수 비교")
    fig = px.line(filtered_df, x="선수명", y="출장 수", markers=True, color="리그")
    st.plotly_chart(fig, use_container_width=True)

elif graph_type == "도움 수 비교":
    st.subheader("🤝 선수별 도움 수 비교")
    fig = px.bar(filtered_df, x="선수명", y="도움 수", color="선수명")
    st.plotly_chart(fig, use_container_width=True)

elif graph_type == "국가 분포":
    st.subheader("🌍 국가별 선수 분포")
    fig = px.pie(filtered_df, names="국가", title="선수 국적 분포")
    st.plotly_chart(fig, use_container_width=True)
